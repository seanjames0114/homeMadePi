# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# ── Spotify ───────────────────────────────────────────────────────────────────
# 1. Go to https://developer.spotify.com/dashboard and create an app
# 2. Add Redirect URI: http://<your-pi-ip>:5000/api/spotify/callback
# 3. Paste Client ID and Client Secret below
# Note: Requires Spotify Premium for playback control
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/spotify/callback

# ── Pi-hole ───────────────────────────────────────────────────────────────────
# API token: Pi-hole admin → Settings → API / Web interface
PIHOLE_HOST=http://pi.hole
PIHOLE_API_TOKEN=
