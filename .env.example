# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret

# ── Spotify ───────────────────────────────────────────────────────────────────
# 1. https://developer.spotify.com/dashboard → Create App
# 2. Add Redirect URI: http://<your-pi-ip>:5000/api/spotify/callback
# Requires Spotify Premium
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/spotify/callback

# ── Pi-hole ───────────────────────────────────────────────────────────────────
# API token: Pi-hole admin → Settings → API / Web interface
PIHOLE_HOST=http://pi.hole
PIHOLE_API_TOKEN=

# ── Philips Hue ───────────────────────────────────────────────────────────────
# Find bridge IP: https://discovery.meethue.com
# Get username: press bridge button then click "Register" in Smart Home → Lights
HUE_BRIDGE_IP=
HUE_USERNAME=

# ── Kasa Smart Plugs ──────────────────────────────────────────────────────────
# Auto-discovered via network. Optionally list IPs manually (comma-separated)
KASA_HOSTS=

# ── Home Assistant ────────────────────────────────────────────────────────────
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# ── Calendar ──────────────────────────────────────────────────────────────────
# iCal URL: Google Calendar → Settings → "Secret address in iCal format"
# Works with Google, Apple iCloud, Outlook, Fastmail, any iCal feed
ICAL_URL=
